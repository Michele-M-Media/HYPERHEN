#!/usr/bin/env python3
"""Small, deterministic subset of ``xxd -i`` used by vendored payloads."""

from pathlib import Path
import re
import sys


def main() -> int:
    args = sys.argv[1:]
    if len(args) != 2 or args[0] != "-i":
        print("usage: xxd -i FILE", file=sys.stderr)
        return 2
    path = Path(args[1])
    data = path.read_bytes()
    symbol = re.sub(r"[^0-9A-Za-z_]", "_", args[1])
    print(f"unsigned char {symbol}[] = {{")
    for offset in range(0, len(data), 12):
        chunk = data[offset : offset + 12]
        values = ", ".join(f"0x{value:02x}" for value in chunk)
        suffix = "," if offset + len(chunk) < len(data) else ""
        print(f"  {values}{suffix}")
    print("};")
    print(f"unsigned int {symbol}_len = {len(data)};")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
