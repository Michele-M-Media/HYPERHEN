"        + ic(x.i, x.i === 'play' ? 'fill sm' : '') + '<span class=\"pal-txt\"><b>' + esc(x.t) + '</b><small>' + esc(x.s) + '</small></span><span class=\"pal-kind\">' + x.k + '</span></button>';\n"
