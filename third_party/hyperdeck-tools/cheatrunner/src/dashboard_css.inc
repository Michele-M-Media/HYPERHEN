"\n"
".item { display: flex; align-items: center; padding: 13px 16px; margin-bottom: 8px; background: var(--panel); border: 1px solid var(--border); border-radius: var(--r-md); transition: border-color var(--motion-fast) var(--ease-standard); }\n"
