".mods-sum.has { color: var(--accent-hover); }\n"
".mod {\n"
"  position: relative; display: flex; align-items: center; padding: 13px 16px; margin-bottom: 8px; background: var(--panel); border: 1px solid var(--border); border-radius: var(--r-md);\n"
"  transition: background var(--motion-ui) var(--ease-standard), border-color var(--motion-ui) var(--ease-standard);\n"
"}\n"
".mod::before { content: \"\"; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 0 3px 3px 0; background: var(--accent); transform: scaleY(0); transition: transform var(--motion-ui) var(--ease-spring); }\n"
".mod:hover { border-color: rgba(var(--white-rgb), .22); }\n"
