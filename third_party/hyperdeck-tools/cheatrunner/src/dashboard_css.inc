"html[dir=\"rtl\"] .rail-dot { left: auto; right: 28px; }\n"
"html[dir=\"rtl\"] .rail-item, html[dir=\"rtl\"] .cmdk, html[dir=\"rtl\"] .pal-item, html[dir=\"rtl\"] .sup-opt, html[dir=\"rtl\"] .sup-addr, html[dir=\"rtl\"] .theme-opt { text-align: right; }\n"
"html[dir=\"rtl\"] .rail-item .ic, html[dir=\"rtl\"] .btn .ic, html[dir=\"rtl\"] .tile-actions .btn .ic, html[dir=\"rtl\"] .toast .ic, html[dir=\"rtl\"] .dl-stat span .ic,\n"
