".games-bar .select { width: auto; margin-right: 12px; }\n"
".chips-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 20px; }\n"
".grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(232px, 1fr)); grid-gap: 20px; }\n"
".tile {\n"
"  position: relative; display: flex; flex-direction: column; overflow: hidden; cursor: pointer; background: var(--panel); border: 1px solid var(--border); border-radius: var(--r-lg);\n"
"  box-shadow: inset 0 1px 0 var(--edge);\n"
"  transition: border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);\n"
"}\n"
"@media (hover: hover) { .tile:hover { transform: translateY(-3px); border-color: rgba(var(--accent-rgb), .55); box-shadow: 0 20px 44px -18px rgba(0, 0, 0, .65), 0 0 0 1px rgba(var(--accent-rgb), .18); } }\n"
".tile:active { transform: scale(.985); }\n"
".tile.running { border-color: rgba(var(--ok-rgb), .65); }\n"
".tile-cover { position: relative; width: 100%; padding-bottom: 100%; background: var(--panel-2); overflow: hidden; }\n"
".cover { position: relative; overflow: hidden; background: var(--panel-2); }\n"
".cover .ph, .tile-cover .ph { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--dim); font-weight: 800; font-size: 52px; opacity: .6; background: radial-gradient(circle at 30% 20%, rgba(var(--accent-rgb), .24), transparent 70%), var(--panel-2); }\n"
".cover .tile-img { transition: transform var(--motion-panel) var(--ease-standard); }\n"
".tile-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-size: cover; background-position: center; background-repeat: no-repeat; }\n"
"@media (hover: hover) { .tile:hover .tile-img { transform: scale(1.05); } }\n"
".tile-cover::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: 0; height: 48%; background: linear-gradient(transparent, rgba(0, 0, 0, .55)); pointer-events: none; }\n"
".tile-cover::before, .cover::before { content: \"\"; position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .07); pointer-events: none; }\n"
".plat-badge { display: inline-flex; align-items: center; height: 18px; padding: 0 7px; border-radius: 4px; font-size: 11px; font-weight: 800; letter-spacing: .03em; }\n"
".plat-badge.PS5 { background: #fff; color: #000; }\n"
".plat-badge.PS4 { background: #000; color: #fff; border: 1px solid rgba(255, 255, 255, .15); }\n"
".tile-fav { position: absolute; z-index: 2; top: 8px; right: 8px; background: rgba(0, 0, 0, .55); color: #fff; }\n"
