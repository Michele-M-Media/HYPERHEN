"\n"
".ready { display: grid; grid-template-columns: repeat(3, 1fr); grid-gap: 10px; margin-bottom: 14px; }\n"
".rd { display: flex; align-items: center; min-width: 0; padding: 12px 14px; border-radius: var(--r-md); background: var(--panel); border: 1px solid var(--border); }\n"
