"  .set-row.sw .set-ctl { width: auto; }\n"
"  .kv { grid-template-columns: repeat(2, 1fr); grid-gap: 10px; }\n"
"  .kv > div { padding: 10px 12px; }\n"
"  .dl { padding: 14px; }\n"
"  .dl-stat { padding: 8px 10px; }\n"
"  .dl-stat span { font-size: 10.5px; letter-spacing: .2px; }\n"
"  .dl-stat span .ic { display: none; }\n"
"  .dl-stat b { font-size: 15px; white-space: nowrap; }\n"
"  .dl-pct { font-size: 24px; }\n"
"  .dl-stats { grid-template-columns: repeat(2, 1fr); }\n"
"  .panel { padding: 16px; }\n"
"  .sec-head { flex-wrap: wrap; }\n"
"  .sec-side { margin: 10px 0 0; }\n"
"  .row .btn.half { flex: 1 1 100%; }\n"
"  .banner { flex-wrap: wrap; }\n"
"  .banner .btn { margin: 10px 0 0 34px; }\n"
"  .sup-grid, .lang-grid { grid-template-columns: 1fr; }\n"
"  .set-ctl.lang { width: 100%; }\n"
"  .mods-head .search { flex: 1 0 100%; margin: 0 0 8px; }\n"
"  .themes { grid-template-columns: repeat(3, 1fr); }\n"
"  .set-ctl.wide { width: 100%; }\n"
"  .seg { display: flex; width: 100%; }\n"
"  .seg-b { flex: 1; padding: 5px 6px; font-size: 12.5px; }\n"
"  .log-tools .input { flex: 1 0 100%; }\n"
"}\n"
"@media (max-width: 360px) {\n"
"  .view, .topbar { padding-left: 12px; padding-right: 12px; }\n"
"  .themes { grid-template-columns: repeat(2, 1fr); }\n"
"  .tile-cover { width: 96px; }\n"
"  .tile-actions .btn .ic { display: none; }\n"
"}\n"
"@media (max-height: 480px) and (orientation: landscape) { .modal-card { max-height: 94vh; padding: 18px; } .modal.top { padding-top: 4vh; } }\n"
"\n"
"/* Reduced effects preset. */\n"
".lite *, .lite *::before, .lite *::after { animation: none !important; transition-duration: 0s !important; box-shadow: none !important; }\n"
".lite .switch, .lite .switch::after, .lite .toast, .lite .modal, .lite .modal-card { transition-duration: var(--motion-instant) !important; }\n"
".lite .ambient, .lite .live-bg, .lite .t-bg { display: none; }\n"
".lite .topbar { position: static; -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--bg); }\n"
".lite .rail { background: var(--panel); }\n"
".lite .sk { background: var(--panel-2); }\n"
".lite .tile-cover::after { display: none; }\n"
".lite .cover .ph, .lite .tile-cover .ph { background: var(--panel-3); }\n"
".lite .tile-live { background: #0b2a18; }\n"
"html.lite .sup-hero { background: var(--panel-2); }\n"
".lite .sup-heart { background: #db2777; }\n"
".lite .cta-support { background: var(--support); }\n"
".lite .cta-support::after { display: none; }\n"
".lite .tile:hover, .lite .tile:active, .lite .link-card:hover, .lite .sup-opt:hover, .lite .sup-addr:hover, .lite .social:hover, .lite .cta-support:hover { transform: none; filter: none; }\n"
".lite .tile:hover .tile-img { transform: none; }\n"
".lite .rail-item.active { background: rgba(var(--accent-rgb), .18); }\n"
".lite .btn:not(.ghost):not(.danger):not(.soft):not(.quiet) { background: var(--accent); }\n"
".lite .dl.run .dl-bar > i::after { display: none; }\n"
".lite .sup-name { text-shadow: none; }\n"
".lite .tile.running, .lite .playing { border-width: 2px; }\n"
".lite .social-discord, .lite .social-bluesky { background: #1e216c; }\n"
"/* Controller focus: the PS5 browser moves its own pointer with the D-pad, so this only styles the focus look. */\n"
".ps5 :focus { outline: 3px solid var(--accent-hover); outline-offset: 3px; }\n"
".ps5 .tile:focus { z-index: 2; }\n"
".ps5 .view:focus, .ps5 [tabindex=\"-1\"]:focus { outline: none; }\n"
".ps5 .rail-item:focus { outline-offset: -3px; background: rgba(var(--accent-rgb), .18); color: var(--text); }\n"
"@media (prefers-reduced-motion: reduce) {\n"
"  *, *::before, *::after { animation: none !important; transition-duration: 0s !important; }\n"
"  .sk { background: var(--panel-2); }\n"
"  .sup-name { text-shadow: none; }\n"
"}\n"
"\n"
"/* ---------- right-to-left (Arabic, Persian) ---------- */\n"
