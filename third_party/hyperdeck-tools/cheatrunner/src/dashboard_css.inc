"html[dir=\"rtl\"] .rd-ic, html[dir=\"rtl\"] .mod-ic, html[dir=\"rtl\"] .live-cover, html[dir=\"rtl\"] .t-cover { margin-right: 0; margin-left: 14px; }\n"
"html[dir=\"rtl\"] .top-brand b, html[dir=\"rtl\"] .stage-txt { margin-right: 0; margin-left: 16px; }\n"
"html[dir=\"rtl\"] .search .ic { left: auto; right: 13px; }\n"
