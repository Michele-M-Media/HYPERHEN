"html[dir=\"rtl\"] .tile-actions .btn + .btn, html[dir=\"rtl\"] .modal-actions .btn, html[dir=\"rtl\"] .item .btn, html[dir=\"rtl\"] .item .pill, html[dir=\"rtl\"] .banner .btn, html[dir=\"rtl\"] .banner .icon-btn { margin-left: 0; margin-right: 8px; }\n"
