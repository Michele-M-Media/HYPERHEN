"\n"
".modal-card.qr { max-width: 380px; text-align: center; }\n"
".modal-card.qr h2 { display: flex; align-items: center; justify-content: center; }\n"
".modal-card.qr h2 .ic { margin-right: 8px; color: var(--accent-hover); }\n"
".qr-box { width: 232px; max-width: 100%; margin: 4px auto 12px; padding: 6px; border-radius: var(--r-lg); background: #fff; box-shadow: var(--sh-2); }\n"
".qr-box svg { display: block; max-width: 100%; height: auto; }\n"
".qr-url { color: var(--dim); font-size: 12.5px; word-break: break-all; }\n"
".modal-card.qr .modal-actions { justify-content: center; }\n"
"\n"
".i18n-wait body { visibility: hidden; }\n"
".flag { width: 24px; height: 18px; flex-shrink: 0; margin-right: 10px; border-radius: 3px; object-fit: cover; box-shadow: 0 0 0 1px rgba(var(--white-rgb), .2); }\n"
".icon-btn .flag { width: 20px; height: 14px; margin: 0 !important; }\n"
".lang-btn { width: 100%; justify-content: flex-start; }\n"
".lang-grid { display: grid; grid-template-columns: 1fr 1fr; grid-gap: 8px; }\n"
".lang-opt { display: flex; align-items: center; min-height: 44px; padding: 8px 12px; border-radius: var(--r-md); border: 1px solid var(--border); background: var(--panel-2); color: var(--text); text-align: start; font-weight: 600; }\n"
".lang-opt:hover { border-color: rgba(var(--accent-rgb), .5); }\n"
".lang-opt.on { border-color: rgba(var(--accent-rgb), .8); background: rgba(var(--accent-rgb), .12); }\n"
".lang-opt .ic:last-child { margin-left: auto; margin-right: 0; color: var(--accent-hover); }\n"
"html[dir=\"rtl\"] .lang-opt .ic:last-child { margin-left: 0; margin-right: auto; }\n"
".modal-card.lang { max-width: 460px; }\n"
"\n"
"/* ---------- responsive ---------- */\n"
"@media (max-width: 1180px) { .src-cols { grid-template-columns: 1fr; } }\n"
"@media (max-width: 1100px) {\n"
"  #qrBtn { display: none; }\n"
"  .cmdk { flex: 0 0 auto; }\n"
"  .cmdk span, .cmdk kbd { display: none; }\n"
"  .cmdk .ic { margin-right: 0; }\n"
"  .cmdk { padding: 8px 11px; }\n"
"}\n"
"@media (max-width: 860px) {\n"
"  .rail { top: auto; width: auto; right: 0; bottom: 0; flex-direction: row; padding: 6px 8px; padding-bottom: calc(6px + env(safe-area-inset-bottom)); border-right: 0; border-top: 1px solid var(--border); background: rgba(var(--bg-rgb), .96); }\n"
"  .rail-brand, .rail-collapse, .rail-credit { display: none; }\n"
"  .rail-item { flex: 1; flex-direction: column; justify-content: center; text-align: center; padding: 6px 4px; margin: 0 2px; font-size: 11px; min-height: 52px; }\n"
"  .rail-item .ic { margin: 0 0 3px; }\n"
"  .rail-item::before { left: 25%; right: 25%; top: -6px; bottom: auto; width: auto; height: 3px; border-radius: 0 0 3px 3px; transform: scaleX(0); }\n"
"  .rail-item.active::before { transform: scaleX(1); }\n"
"  .rail-dot { top: 6px; left: 55%; }\n"
"  .col { margin-left: 0; padding-bottom: calc(72px + env(safe-area-inset-bottom)); }\n"
"  .topbar, .view { padding-left: 18px; padding-right: 18px; }\n"
"  .topbar { position: static; }\n"
"  .top-brand { display: flex; }\n"
"  .cmdk { margin-left: auto; margin-right: 6px; }\n"
"  .toasts { bottom: calc(80px + env(safe-area-inset-bottom)); }\n"
"  .grid { grid-template-columns: repeat(auto-fill, minmax(164px, 1fr)); grid-gap: 14px; }\n"
"  .themes { grid-template-columns: repeat(3, 1fr); }\n"
"  .stage h1 { font-size: 24px; }\n"
"}\n"
"@media (max-width: 640px) {\n"
"  .ready { grid-template-columns: 1fr; }\n"
"  .rd { padding: 10px 14px; }\n"
"  .modal { align-items: flex-end; padding: 0; }\n"
"  .modal-card { max-width: none; max-height: 86vh; border-radius: var(--r-xl) var(--r-xl) 0 0; padding-bottom: calc(26px + env(safe-area-inset-bottom)); transform: translateY(40px); }\n"
"  .modal.top { align-items: flex-start; padding: 12vh 12px 0; }\n"
"  .modal.top .modal-card { border-radius: var(--r-xl); transform: translateY(8px) scale(.98); }\n"
"  .modal.top.show .modal-card { transform: none; }\n"
"  .t-head { flex-wrap: wrap; padding: 18px; }\n"
"  .t-cover { width: 88px; height: 88px; margin-right: 16px; }\n"
"  .t-info h1 { font-size: 21px; }\n"
"  .t-act { width: 100%; justify-content: flex-start; margin-top: 14px; }\n"
"  .t-act > * { margin: 0 8px 0 0; }\n"
"}\n"
"@media (max-width: 560px) {\n"
"  .topbar { padding-top: 10px; padding-bottom: 10px; }\n"
"  .topbar-right { width: 100%; margin-top: 6px; justify-content: flex-start; }\n"
"  .topbar-right > * { margin: 3px 6px 3px 0; }\n"
"  .status-chip { flex: 1 1 140px; min-width: 0; max-width: none; order: -2; }\n"
"  #langBtn { order: -1; }\n"
"  .socials { margin-left: 0; }\n"
"  .social { margin-left: 0; margin-right: 6px; }\n"
"  .cta-support { flex: 1 1 auto; margin-left: 0; }\n"
"  .dl-chip { order: -3; }\n"
"  .view { padding: 18px 16px 40px; }\n"
"  .stage { margin-bottom: 16px; }\n"
"  .stage h1 { font-size: 22px; }\n"
"  .stage-act { width: 100%; margin-top: 12px; }\n"
"  .stage-act > * { margin: 0 8px 0 0; }\n"
"  .games-bar .search { flex: 1 0 100%; max-width: none; margin-right: 0; margin-bottom: 8px; }\n"
"  .input, .select { font-size: 16px; }\n"
"  .grid { grid-template-columns: 1fr; grid-gap: 12px; }\n"
"  .tile { flex-direction: row; }\n"
"  .tile-cover { width: 120px; flex-shrink: 0; padding-bottom: 0; }\n"
"  .tile-cover .ph { font-size: 38px; }\n"
"  .tile-fav { top: 4px; right: 4px; width: 36px; height: 36px; }\n"
"  .tile-live { left: 6px; bottom: 6px; padding: 1px 8px; font-size: 11px; }\n"
"  .tile-body { flex: 1; min-width: 0; padding: 12px; }\n"
"  .tile-name { max-height: 40px; font-size: 14.5px; }\n"
"  .tile-tags { min-height: 22px; margin: 6px 0 4px -6px; }\n"
"  .tile-stats { margin: 0 0 10px; padding: 6px 0; }\n"
"  .tile-stat { font-size: 12px; line-height: 1.7; }\n"
"  .tile-actions .btn { min-height: 40px; padding: 0 8px; }\n"
"  .tile-actions .btn .ic { margin-right: 4px; }\n"
"  .playing { flex-wrap: wrap; padding: 16px; }\n"
"  .live-cover { width: 64px; height: 64px; margin-right: 14px; }\n"
