".live-txt b { display: block; font-size: 21px; font-weight: 800; letter-spacing: -.02em; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n"
".live-meta { display: flex; flex-wrap: wrap; align-items: center; margin-top: 8px; }\n"
