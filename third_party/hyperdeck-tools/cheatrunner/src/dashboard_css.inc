".mod.is-off-lock .mod-name { color: var(--dim); }\n"
".mod-ic { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; flex-shrink: 0; margin-right: 14px; border-radius: var(--r-md); color: var(--dim); background: rgba(var(--white-rgb), .05); transition: color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard); }\n"
