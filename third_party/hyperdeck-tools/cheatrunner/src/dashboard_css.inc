".sup-list { padding: 18px 20px 22px; }\n"
".sup-addr { display: block; width: 100%; margin-bottom: 8px; padding: 12px 14px; text-align: left; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--bg); transition: border-color var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard); }\n"
".sup-addr:hover { transform: translateX(3px); border-color: #2a5e9f; }\n"
".sup-addr-top { display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 12px; }\n"
".sup-addr-top b { color: var(--accent-hover); }\n"
