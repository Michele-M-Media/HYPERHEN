"\n"
".switch {\n"
"  position: relative; flex-shrink: 0; width: 52px; height: 30px; border-radius: 999px; padding: 0; background: var(--panel-3); border: 1px solid var(--border);\n"
"  transition: background var(--motion-ui) var(--ease-standard), border-color var(--motion-ui) var(--ease-standard);\n"
"}\n"
".switch::before { content: \"\"; position: absolute; top: -8px; right: -6px; bottom: -8px; left: -6px; }\n"
".switch::after {\n"
"  content: \"\"; position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: var(--dim);\n"
"  transition: transform var(--motion-ui) var(--ease-spring), background var(--motion-ui) var(--ease-standard), width var(--motion-instant) var(--ease-standard);\n"
"}\n"
".switch:active::after { width: 26px; }\n"
