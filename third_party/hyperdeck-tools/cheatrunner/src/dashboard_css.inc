".sk-tile div.sk-l + div.sk-l { width: 55%; margin-bottom: 16px; }\n"
".sk-row { height: 66px; margin-bottom: 8px; border-radius: var(--r-md); }\n"
"\n"
"/* ---------- library ---------- */\n"
".playing {\n"
"  position: relative; display: flex; align-items: center; overflow: hidden; margin-bottom: 22px; padding: 18px 20px; border-radius: var(--r-lg);\n"
"  background: var(--panel); border: 1px solid rgba(var(--ok-rgb), .4); cursor: pointer;\n"
"  transition: border-color var(--motion-fast) var(--ease-standard);\n"
"}\n"
