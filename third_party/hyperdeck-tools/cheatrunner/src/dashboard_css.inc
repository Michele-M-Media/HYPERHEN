":root {\n"
"  --bg: #0a0e16;\n"
"  --bg-rgb: 10, 14, 22;\n"
"  --panel: #10161f;\n"
"  --panel-2: #161e2a;\n"
"  --panel-3: #1c2636;\n"
"  --border: #24303f;\n"
"  --text: #eaf1f8;\n"
"  --dim: #8b9bad;\n"
"  --accent: #e11d48;\n"
"  --accent-rgb: 225, 29, 72;\n"
"  --accent-hover: #fb3a63;\n"
"  --on-accent: #fff;\n"
"  --info: #38bdf8;\n"
"  --info-rgb: 56, 189, 248;\n"
"  --ok: #34b168;\n"
"  --ok-rgb: 52, 177, 104;\n"
"  --warn: #eab308;\n"
"  --warn-rgb: 234, 179, 8;\n"
"  --err: #ef4444;\n"
"  --err-rgb: 239, 68, 68;\n"
"  --white-rgb: 255, 255, 255;\n"
"  --edge: rgba(var(--white-rgb), .055);\n"
"  --scrim: rgba(0, 0, 0, .62);\n"
"  --support: #c01480;\n"
"  --support-hi: #d92b93;\n"
"  --support-lo: #9e0f68;\n"
"  --support-rgb: 232, 50, 160;\n"
"  --support-edge: rgba(255, 143, 214, .7);\n"
"  --on-support: #fff;\n"
"\n"
"  --r-sm: 8px;\n"
"  --r-md: 12px;\n"
"  --r-lg: 16px;\n"
"  --r-xl: 22px;\n"
"  --sh-1: 0 1px 2px rgba(0, 0, 0, .28);\n"
"  --sh-2: 0 14px 36px rgba(0, 0, 0, .42);\n"
"  --rail-w: 224px;\n"
"\n"
"  --motion-instant: 120ms;\n"
"  --motion-fast: 180ms;\n"
"  --motion-ui: 260ms;\n"
"  --motion-panel: 360ms;\n"
"  --motion-rail: 300ms;\n"
"  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);\n"
"  --ease-out: cubic-bezier(0, 0, 0.2, 1);\n"
"  --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);\n"
"}\n"
"html[data-theme=\"crimson\"] { --bg: #0f0a0c; --bg-rgb: 15, 10, 12; --panel: #171013; --panel-2: #20151a; --panel-3: #2a1c22; --border: #3a242c; --dim: #a9909a; }\n"
"html[data-theme=\"midnight\"] { --bg: #070b16; --bg-rgb: 7, 11, 22; --panel: #0d1424; --panel-2: #131c31; --panel-3: #1a2540; --border: #22304d; --accent: #3b82f6; --accent-rgb: 59, 130, 246; --accent-hover: #60a5fa; }\n"
"html[data-theme=\"oled\"] { --bg: #000; --bg-rgb: 0, 0, 0; --panel: #0b0b0c; --panel-2: #141416; --panel-3: #1c1c20; --border: #242428; }\n"
"html[data-theme=\"light\"] {\n"
"  --bg: #f4f6fa; --bg-rgb: 244, 246, 250; --panel: #fff; --panel-2: #f1f4f9; --panel-3: #e8edf5; --border: #d8e0ea;\n"
"  --text: #142033; --dim: #56687d; --white-rgb: 20, 32, 51; --edge: rgba(255, 255, 255, .9); --scrim: rgba(20, 32, 51, .45); --support-edge: #8f1050;\n"
"  --accent: #d6123f; --accent-rgb: 214, 18, 63; --accent-hover: #ef2f59;\n"
"  --ok: #1a8f4d; --ok-rgb: 26, 143, 77; --warn: #a16207; --warn-rgb: 161, 98, 7; --info: #0b78a8; --info-rgb: 11, 120, 168; --err: #d92d2d; --err-rgb: 217, 45, 45;\n"
"  --sh-1: 0 1px 2px rgba(20, 32, 51, .08); --sh-2: 0 14px 36px rgba(20, 32, 51, .18);\n"
"}\n"
"\n"
"html { color-scheme: dark; }\n"
"html[data-theme=\"light\"] { color-scheme: light; }\n"
"* { box-sizing: border-box; }\n"
"html, body { margin: 0; min-height: 100%; }\n"
"body {\n"
"  background: var(--bg); color: var(--text);\n"
"  font: 15px/1.5 system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n"
"  -webkit-font-smoothing: antialiased;\n"
"}\n"
"img { display: block; }\n"
"button, input, select { font: inherit; color: inherit; }\n"
"button { cursor: pointer; -webkit-tap-highlight-color: transparent; }\n"
"a { color: inherit; text-decoration: none; }\n"
"h1, h2, h3, p { margin: 0; }\n"
"[hidden] { display: none !important; }\n"
"[data-act] { cursor: pointer; }\n"
":focus { outline: 2px solid var(--accent-hover); outline-offset: 2px; }\n"
":focus:not(:focus-visible) { outline: none; }\n"
".view:focus { outline: none; }\n"
".modal-card, .console, .tabs, .pal-list { scrollbar-width: thin; scrollbar-color: var(--border) transparent; }\n"
".modal-card::-webkit-scrollbar, .console::-webkit-scrollbar, .tabs::-webkit-scrollbar { width: 8px; height: 8px; }\n"
".modal-card::-webkit-scrollbar-thumb, .console::-webkit-scrollbar-thumb, .tabs::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }\n"
".sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n"
"\n"
".ic { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }\n"
".ic.fill { fill: currentColor; stroke: none; }\n"
".ic.sm { width: 15px; height: 15px; }\n"
".mono { font-family: ui-monospace, Menlo, Consolas, monospace; }\n"
"html[dir=\"rtl\"] .mono, html[dir=\"rtl\"] kbd { direction: ltr; unicode-bidi: isolate; }\n"
".muted { color: var(--dim); }\n"
".small { font-size: 13px; }\n"
".spacer { flex: 1; }\n"
"\n"
"@keyframes fade-up { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n"
"@keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }\n"
"@keyframes spin { to { transform: rotate(360deg); } }\n"
"@keyframes pulse { 50% { opacity: .35; } }\n"
"@keyframes tile-in { from { opacity: 0; transform: translateY(14px) scale(.97); } to { opacity: 1; transform: none; } }\n"
"@keyframes heart-float { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-5px) rotate(2deg); } }\n"
"@keyframes pop { 0% { transform: scale(1); } 40% { transform: scale(1.35) rotate(-8deg); } 100% { transform: scale(1); } }\n"
"@keyframes neon {\n"
"  0% { color: #ff4040; text-shadow: 0 0 8px #ff4040; } 17% { color: #ff9900; text-shadow: 0 0 8px #ff9900; }\n"
"  33% { color: #ffe600; text-shadow: 0 0 8px #ffe600; } 50% { color: #00ff88; text-shadow: 0 0 8px #00ff88; }\n"
"  67% { color: #00aaff; text-shadow: 0 0 8px #00aaff; } 83% { color: #cc44ff; text-shadow: 0 0 8px #cc44ff; }\n"
"  100% { color: #ff4040; text-shadow: 0 0 8px #ff4040; }\n"
"}\n"
"@keyframes dl-shine { from { transform: translateX(-60px); } to { transform: translateX(260px); } }\n"
"@keyframes dl-ind { from { transform: translateX(0); } to { transform: translateX(150%); } }\n"
"\n"
"/* ---------- ambient + shell ---------- */\n"
".ambient {\n"
"  position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none;\n"
"  background: radial-gradient(900px 520px at 92% -14%, rgba(var(--accent-rgb), .13), transparent 62%), radial-gradient(640px 460px at -10% 108%, rgba(var(--info-rgb), .06), transparent 58%), var(--bg);\n"
"}\n"
".ambient::after {\n"
"  content: \"\"; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-size: 44px 44px; opacity: .45;\n"
"  background-image: linear-gradient(rgba(255, 255, 255, .028) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .022) 1px, transparent 1px);\n"
"  -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .55), transparent 62%); mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .55), transparent 62%);\n"
"}\n"
"html[data-theme=\"oled\"] .ambient { background: radial-gradient(900px 520px at 92% -14%, rgba(var(--accent-rgb), .08), transparent 62%), #000; }\n"
"html[data-theme=\"light\"] .ambient::after { background-image: linear-gradient(rgba(30, 64, 100, .045) 1px, transparent 1px), linear-gradient(90deg, rgba(30, 64, 100, .04) 1px, transparent 1px); opacity: .6; }\n"
"\n"
".app { display: flex; min-height: 100vh; }\n"
".rail {\n"
"  position: fixed; top: 0; bottom: 0; left: 0; width: var(--rail-w); z-index: 20; display: flex; flex-direction: column; overflow: hidden;\n"
"  padding: 18px 12px 0; background: linear-gradient(180deg, var(--panel), rgba(var(--bg-rgb), .96)); border-right: 1px solid var(--border);\n"
"  transition: width var(--motion-rail) var(--ease-standard);\n"
"}\n"
".rail-brand { display: flex; align-items: center; padding: 2px 0 22px; white-space: nowrap; }\n"
".rail-brand img { flex-shrink: 0; margin-right: 12px; border-radius: var(--r-md); box-shadow: 0 0 0 1px rgba(var(--accent-rgb), .5), 0 8px 22px -6px rgba(var(--accent-rgb), .55); }\n"
".rail-brand-text b { display: block; font-size: 18px; font-weight: 800; letter-spacing: -.02em; line-height: 1.15; }\n"
".ver-text { display: inline-block; margin-top: 3px; padding: 0 8px; border-radius: 999px; background: rgba(var(--white-rgb), .07); color: var(--dim); font-size: 11.5px; font-weight: 700; letter-spacing: .02em; }\n"
".rail-item {\n"
"  position: relative; display: flex; align-items: center; width: 100%; min-height: 44px; padding: 10px 12px; margin-bottom: 4px;\n"
"  border: 0; border-radius: var(--r-md); background: transparent; color: var(--dim); font-weight: 650; text-align: left;\n"
"  transition: background var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard);\n"
"}\n"
".rail-item .ic { margin-right: 12px; }\n"
".rail-item:hover { background: rgba(var(--white-rgb), .05); color: var(--text); }\n"
".rail-item::before {\n"
"  content: \"\"; position: absolute; left: -12px; top: 11px; bottom: 11px; width: 3px; border-radius: 0 3px 3px 0;\n"
"  background: var(--accent); transform: scaleY(0); transition: transform var(--motion-ui) var(--ease-spring);\n"
"}\n"
".rail-item.active { background: rgba(var(--accent-rgb), .13); color: var(--text); }\n"
".rail-item.active .ic { color: var(--accent-hover); }\n"
".rail-item.active::before { transform: scaleY(1); }\n"
".rail-dot { position: absolute; top: 10px; left: 28px; width: 8px; height: 8px; border-radius: 50%; background: var(--info); box-shadow: 0 0 0 2px var(--panel); }\n"
".rail-dot.live { background: var(--ok); animation: pulse 1.8s ease-in-out infinite; }\n"
".rail-update { color: var(--ok); }\n"
".rail-update:hover { color: var(--ok); }\n"
".rail-collapse { margin-top: auto; margin-bottom: 8px; }\n"
".rail-credit { margin: 0 -12px; padding: 14px 20px; border-top: 1px solid var(--border); font-size: 12px; line-height: 1.5; color: var(--dim); white-space: nowrap; overflow: hidden; }\n"
".rail-collapse .ic { transition: transform var(--motion-rail) var(--ease-standard); }\n"
".rail-brand-text, .rail-item span, .rail-credit { white-space: nowrap; transition: opacity var(--motion-fast) var(--ease-standard) var(--rail-fade-in, 120ms); }\n"
"@media (min-width: 861px) {\n"
"  html[data-rail=\"min\"] { --rail-w: 68px; --rail-fade-in: 0ms; }\n"
"  html[data-rail=\"min\"] .rail-brand-text, html[data-rail=\"min\"] .rail-item span, html[data-rail=\"min\"] .rail-credit { opacity: 0; pointer-events: none; }\n"
"  html[data-rail=\"min\"] .rail-collapse .ic { transform: rotate(180deg); }\n"
"}\n"
"\n"
".col { flex: 1; min-width: 0; margin-left: var(--rail-w); transition: margin-left var(--motion-rail) var(--ease-standard); }\n"
".topbar {\n"
"  position: -webkit-sticky; position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between;\n"
"  flex-wrap: wrap; padding: 10px 32px; background: rgba(var(--bg-rgb), .78); border-bottom: 1px solid var(--border);\n"
"  -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);\n"
"  transition: box-shadow var(--motion-fast) var(--ease-standard);\n"
"}\n"
".topbar.scrolled { box-shadow: var(--sh-2); }\n"
".top-brand { display: none; align-items: center; min-width: 0; }\n"
".top-brand img { margin-right: 8px; border-radius: 9px; }\n"
".top-brand b { font-size: 17px; font-weight: 800; margin-right: 8px; letter-spacing: -.02em; }\n"
".top-brand .ver-text { margin-top: 0; }\n"
".topbar-right { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; min-width: 0; margin-left: auto; }\n"
".topbar-right > * { margin: 3px 0 3px 6px; }\n"
".cmdk {\n"
"  display: inline-flex; align-items: center; flex: 0 1 380px; min-height: 40px; padding: 8px 10px 8px 14px; border-radius: var(--r-md);\n"
"  background: var(--panel); border: 1px solid var(--border); color: var(--dim); font-size: 14px; text-align: left;\n"
"  transition: border-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);\n"
"}\n"
".cmdk:hover { color: var(--text); border-color: rgba(var(--white-rgb), .25); background: var(--panel-2); }\n"
".cmdk .ic { margin-right: 10px; }\n"
".cmdk span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n"
"kbd { margin-left: 10px; padding: 1px 7px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg); color: var(--dim); font: 600 11px ui-monospace, Menlo, Consolas, monospace; }\n"
"\n"
".status-chip {\n"
"  display: inline-flex; align-items: center; min-height: 36px; max-width: 320px; padding: 4px 14px; border-radius: 999px; background: var(--panel);\n"
"  border: 1px solid var(--border); color: var(--dim); font-size: 13px; font-weight: 650; white-space: nowrap;\n"
"  transition: border-color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);\n"
"}\n"
".status-chip:hover { border-color: rgba(var(--white-rgb), .25); background: var(--panel-2); }\n"
".status-chip .dot { margin-right: 8px; }\n"
".status-chip.ok .dot { color: var(--ok); }\n"
".status-chip.err .dot { color: var(--err); }\n"
".status-chip.warn .dot { color: var(--warn); }\n"
".status-chip .sep { width: 1px; height: 14px; margin: 0 10px; background: var(--border); flex-shrink: 0; }\n"
"#stGame { min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--text); }\n"
"#stEngine { flex-shrink: 0; }\n"
".status-chip.idle #stGame { color: var(--dim); }\n"
".dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex-shrink: 0; margin-right: 7px; }\n"
".dot.live { animation: pulse 1.8s ease-in-out infinite; }\n"
"\n"
".dl-chip {\n"
"  position: relative; display: inline-flex; align-items: center; min-height: 36px; padding: 4px 14px; border-radius: 999px; overflow: hidden;\n"
"  background: rgba(var(--accent-rgb), .12); border: 1px solid rgba(var(--accent-rgb), .45); color: var(--accent-hover); font-size: 13px; font-weight: 700; white-space: nowrap;\n"
"}\n"
".dl-chip .ic { margin-right: 7px; }\n"
".dl-chip-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(var(--accent-rgb), .2); }\n"
".dl-chip-bar b { display: block; height: 100%; width: 0; background: var(--accent-hover); transition: width var(--motion-panel) var(--ease-standard); }\n"
".socials { display: flex; align-items: center; margin-left: 6px; }\n"
".social {\n"
"  display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; padding: 0 10px; margin-left: 6px; border-radius: 999px;\n"
"  color: #fff; font-size: 13px; font-weight: 800; white-space: nowrap; background: none;\n"
"  transition: transform var(--motion-instant) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard), filter var(--motion-fast) var(--ease-standard);\n"
"}\n"
".social .ic { width: 17px; height: 17px; }\n"
".social span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n"
".social:hover { transform: translateY(-1px); filter: brightness(1.15); }\n"
".social:active { transform: scale(.95); }\n"
".social-discord { border: 1px solid rgba(88, 101, 242, .6); background: rgba(30, 33, 108, .4); box-shadow: 0 0 10px rgba(88, 101, 242, .2); }\n"
".social-x { border: 1px solid rgba(255, 255, 255, .22); background: #0a0a0b; }\n"
".social-bluesky { border: 1px solid rgba(0, 133, 254, .6); background: rgba(0, 72, 135, .4); box-shadow: 0 0 10px rgba(0, 133, 254, .2); }\n"
"html[data-theme=\"light\"] .social-discord { background: #5865f2; }\n"
"html[data-theme=\"light\"] .social-bluesky { background: #0085fe; }\n"
"html[data-theme=\"light\"] .social-x { background: #14181d; }\n"
"@media (min-width: 1560px) {\n"
"  .social { padding: 0 14px; }\n"
"  .social .ic { margin-right: 7px; }\n"
"  .social span { position: static; width: auto; height: auto; overflow: visible; clip: auto; }\n"
"}\n"
".cta-support {\n"
"  position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; height: 38px; padding: 0 18px; margin-left: 8px;\n"
"  border: 1px solid var(--support-edge); border-radius: 999px; color: var(--on-support); font-size: 13.5px; font-weight: 800; letter-spacing: .01em; white-space: nowrap;\n"
"  background: linear-gradient(135deg, var(--support-hi) 0%, var(--support) 55%, var(--support-lo) 100%);\n"
"  box-shadow: 0 0 0 1px rgba(var(--support-rgb), .22), 0 8px 22px -6px rgba(var(--support-rgb), .75), inset 0 1px 0 rgba(255, 255, 255, .6);\n"
"  transition: transform var(--motion-instant) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);\n"
"}\n"
".cta-support > * { position: relative; z-index: 1; }\n"
".cta-support .ic { width: 16px; height: 16px; margin-right: 8px; }\n"
".cta-support::after {\n"
"  content: \"\"; position: absolute; top: 0; bottom: 0; left: 0; width: 45%; pointer-events: none;\n"
"  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .7), transparent); transform: translateX(-140%) skewX(-18deg);\n"
"}\n"
".cta-support:hover::after { transform: translateX(320%) skewX(-18deg); transition: transform 650ms var(--ease-out); }\n"
".cta-support:focus-visible::after { transform: translateX(320%) skewX(-18deg); transition: transform 650ms var(--ease-out); }\n"
".cta-support:hover { transform: translateY(-1px); box-shadow: 0 0 0 1px rgba(var(--support-rgb), .45), 0 12px 30px -6px rgba(var(--support-rgb), .95), inset 0 1px 0 rgba(255, 255, 255, .7); }\n"
".cta-support:active { transform: translateY(1px) scale(.96); box-shadow: 0 3px 10px -4px rgba(var(--support-rgb), .8), inset 0 2px 4px rgba(70, 0, 40, .45); }\n"
".cta-support:focus-visible { outline: 3px solid var(--text); outline-offset: 3px; }\n"
"\n"
".view { padding: 28px 32px 56px; max-width: 1360px; }\n"
".page-in { animation: fade-up var(--motion-ui) var(--ease-out) both; }\n"
"\n"
"/* ---------- page header ---------- */\n"
".stage { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; margin-bottom: 22px; }\n"
".stage-txt { min-width: 0; margin-right: 16px; }\n"
".eyebrow { margin: 0 0 6px; color: var(--accent-hover); font-size: 11.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }\n"
".stage h1 { font-size: 28px; line-height: 1.15; font-weight: 800; letter-spacing: -.025em; }\n"
".stage-sub { margin-top: 6px; color: var(--dim); font-size: 14px; max-width: 62ch; }\n"
".stage-act { display: flex; align-items: center; flex-wrap: wrap; }\n"
".stage-act > * { margin-left: 8px; }\n"
"\n"
"/* ---------- primitives ---------- */\n"
".pill {\n"
"  display: inline-flex; align-items: center; padding: 3px 11px; border-radius: 999px; white-space: nowrap;\n"
"  background: rgba(var(--white-rgb), .05); border: 1px solid var(--border); color: var(--dim); font-size: 12.5px; font-weight: 650;\n"
"  transition: background var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);\n"
"}\n"
".pill .ic { margin-right: 5px; width: 14px; height: 14px; }\n"
".pill.on { color: var(--accent-hover); border-color: rgba(var(--accent-rgb), .45); background: rgba(var(--accent-rgb), .12); }\n"
".pill.ok { color: var(--ok); border-color: rgba(var(--ok-rgb), .4); background: rgba(var(--ok-rgb), .1); }\n"
".pill.warn { color: var(--warn); border-color: rgba(var(--warn-rgb), .4); background: rgba(var(--warn-rgb), .1); }\n"
".pill.err { color: var(--err); border-color: rgba(var(--err-rgb), .4); background: rgba(var(--err-rgb), .1); }\n"
".pill.patch { color: var(--info); border-color: rgba(var(--info-rgb), .45); background: rgba(var(--info-rgb), .1); }\n"
"\n"
".panel {\n"
"  margin-bottom: 18px; padding: 22px; background: var(--panel); border: 1px solid var(--border); border-radius: var(--r-lg);\n"
"  box-shadow: inset 0 1px 0 var(--edge);\n"
"}\n"
".panel.flush { padding: 0; }\n"
".sec-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px; }\n"
".sec-txt { display: flex; align-items: flex-start; min-width: 0; }\n"
".sec-ic { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex-shrink: 0; margin-right: 14px; border-radius: var(--r-md); background: rgba(var(--accent-rgb), .12); color: var(--accent-hover); }\n"
".sec-ic.info { background: rgba(var(--info-rgb), .12); color: var(--info); }\n"
".sec-ic.warn { background: rgba(var(--warn-rgb), .12); color: var(--warn); }\n"
".sec-ic.err { background: rgba(var(--err-rgb), .12); color: var(--err); }\n"
