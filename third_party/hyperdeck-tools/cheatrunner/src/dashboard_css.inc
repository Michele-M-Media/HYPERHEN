".playing > *:not(.live-bg) { position: relative; z-index: 1; }\n"
".live-bg, .t-bg { position: absolute; top: -30px; right: -30px; bottom: -30px; left: -30px; z-index: 0; background-size: cover; background-position: center; filter: blur(34px) saturate(1.35); opacity: .3; pointer-events: none; }\n"
".playing::before { content: \"\"; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; z-index: 2; background: var(--ok); }\n"
".live-cover { width: 84px; height: 84px; flex-shrink: 0; margin-right: 18px; border-radius: var(--r-md); }\n"
".live-txt { flex: 1; min-width: 0; margin-right: 16px; }\n"
