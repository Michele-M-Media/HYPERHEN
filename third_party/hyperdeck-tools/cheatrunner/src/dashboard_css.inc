".sec-side { flex-shrink: 0; margin-left: 14px; }\n"
"\n"
".btn {\n"
"  display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 8px 16px; border-radius: var(--r-md);\n"
"  border: 1px solid transparent; background: var(--accent); color: var(--on-accent); font-weight: 700; white-space: nowrap;\n"
"  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .2), 0 8px 20px -10px rgba(var(--accent-rgb), .9);\n"
"  transition: background var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), opacity var(--motion-fast) var(--ease-standard), transform var(--motion-instant) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);\n"
"}\n"
".btn .ic { margin-right: 8px; }\n"
".btn:hover { background: var(--accent-hover); }\n"
".btn:active { transform: scale(.97); }\n"
".btn.ghost { background: var(--panel-2); border-color: var(--border); color: var(--text); font-weight: 650; box-shadow: none; }\n"
".btn.ghost:hover { background: var(--panel-3); border-color: rgba(var(--white-rgb), .22); }\n"
".btn.quiet { background: transparent; border-color: transparent; color: var(--dim); font-weight: 650; box-shadow: none; }\n"
".btn.quiet:hover { background: rgba(var(--white-rgb), .06); color: var(--text); }\n"
".btn.soft { --c: var(--accent-rgb); border-color: rgba(var(--c), .5); background: rgba(var(--c), .13); color: var(--accent-hover); box-shadow: none; }\n"
".btn.soft:hover { background: rgba(var(--c), .24); border-color: rgba(var(--c), .8); }\n"
".btn.soft.warn { --c: var(--warn-rgb); color: var(--warn); }\n"
".btn.danger { background: rgba(var(--err-rgb), .13); border-color: rgba(var(--err-rgb), .45); color: var(--err); box-shadow: none; }\n"
".btn.danger:hover { background: rgba(var(--err-rgb), .24); border-color: rgba(var(--err-rgb), .75); }\n"
".btn.sm { min-height: 34px; padding: 5px 13px; font-size: 13.5px; }\n"
".btn.lg { min-height: 46px; padding: 10px 22px; font-size: 15px; }\n"
".btn.done { background: rgba(var(--ok-rgb), .14); border-color: rgba(var(--ok-rgb), .45); color: var(--ok); box-shadow: none; }\n"
".btn.is-busy .ic { animation: spin .9s linear infinite; }\n"
".btn[disabled] { opacity: .5; pointer-events: none; }\n"
".icon-btn {\n"
"  display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 0; border-radius: var(--r-md);\n"
"  background: transparent; color: var(--dim);\n"
"  transition: background var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard), transform var(--motion-instant) var(--ease-standard);\n"
"}\n"
".icon-btn:hover { background: rgba(var(--white-rgb), .08); color: var(--text); }\n"
".icon-btn:active { transform: scale(.92); }\n"
".icon-btn.fav-on { color: #f5b301; }\n"
".icon-btn.pop .ic { animation: pop 420ms var(--ease-spring); }\n"
"\n"
".row { display: flex; flex-wrap: wrap; align-items: center; margin: -4px; }\n"
".row > * { margin: 4px; }\n"
".row .grow { flex: 1; min-width: 160px; }\n"
".input, .select {\n"
"  width: 100%; min-height: 42px; padding: 9px 13px; border-radius: var(--r-md); background: var(--panel-2);\n"
"  border: 1px solid var(--border); color: var(--text);\n"
"  transition: border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);\n"
"}\n"
".input:hover, .select:hover { border-color: rgba(var(--white-rgb), .22); }\n"
".input:focus, .select:focus { border-color: rgba(var(--accent-rgb), .75); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), .16); }\n"
".search { position: relative; }\n"
".search .ic { position: absolute; left: 13px; top: 50%; margin-top: -9px; color: var(--dim); pointer-events: none; }\n"
".search .input { padding-left: 40px; padding-right: 40px; }\n"
".search-clear { position: absolute; right: 4px; top: 50%; margin-top: -16px; width: 32px; height: 32px; }\n"
".chk { width: 20px; height: 20px; margin: 0 10px 0 0; flex-shrink: 0; accent-color: var(--accent); }\n"
".chk-row { min-height: 44px; cursor: pointer; }\n"
"\n"
".chips { display: flex; flex-wrap: wrap; margin: -3px; }\n"
".chip {\n"
"  margin: 3px; min-height: 36px; padding: 6px 15px; border-radius: 999px; background: transparent; border: 1px solid var(--border);\n"
"  color: var(--dim); font-weight: 650; font-size: 13.5px;\n"
"  transition: background var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), transform var(--motion-instant) var(--ease-standard);\n"
"}\n"
".chip:hover { color: var(--text); border-color: rgba(var(--white-rgb), .25); }\n"
".chip:active { transform: scale(.96); }\n"
".chip em { font-style: normal; font-weight: 500; opacity: .65; margin-left: 6px; unicode-bidi: isolate; }\n"
".chip.active { background: rgba(var(--accent-rgb), .15); border-color: rgba(var(--accent-rgb), .55); color: var(--text); }\n"
".chip.active em { color: var(--accent-hover); opacity: 1; }\n"
"\n"
".seg { display: inline-flex; padding: 3px; border-radius: var(--r-md); background: var(--panel-2); border: 1px solid var(--border); }\n"
".seg-b { min-height: 34px; padding: 5px 14px; border: 0; border-radius: 9px; background: transparent; color: var(--dim); font-weight: 650; font-size: 13.5px; transition: background var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard); }\n"
".seg-b:hover { color: var(--text); }\n"
".seg-b.on { background: var(--panel-3); color: var(--text); box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), .55); }\n"
"\n"
".tabs { display: flex; border-bottom: 1px solid var(--border); margin-bottom: 20px; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; }\n"
".tab { position: relative; min-height: 46px; padding: 11px 20px; border: 0; background: transparent; color: var(--dim); font-weight: 650; white-space: nowrap; transition: color var(--motion-fast) var(--ease-standard); }\n"
".tab:hover { color: var(--text); }\n"
".tab::after { content: \"\"; position: absolute; left: 12px; right: 12px; bottom: 0; height: 2px; border-radius: 2px; background: var(--accent); transform: scaleX(0); transition: transform var(--motion-ui) var(--ease-spring); }\n"
".tab.active { color: var(--text); }\n"
".tab.active::after { transform: scaleX(1); }\n"
"\n"
".banner { display: flex; align-items: center; padding: 12px 14px; border-radius: var(--r-md); margin-bottom: 14px; background: rgba(var(--warn-rgb), .09); border: 1px solid rgba(var(--warn-rgb), .35); color: var(--text); }\n"
".banner > .ic { margin-right: 12px; color: var(--warn); }\n"
".banner.err { background: rgba(var(--err-rgb), .09); border-color: rgba(var(--err-rgb), .4); }\n"
".banner.err > .ic { color: var(--err); }\n"
".banner.ok { background: rgba(var(--ok-rgb), .08); border-color: rgba(var(--ok-rgb), .35); }\n"
".banner.ok > .ic { color: var(--ok); }\n"
".banner.info { background: rgba(var(--info-rgb), .08); border-color: rgba(var(--info-rgb), .3); }\n"
".banner.info > .ic { color: var(--info); }\n"
".banner .txt { flex: 1; min-width: 0; }\n"
".banner .txt b { display: block; font-weight: 700; }\n"
".banner .txt span { color: var(--dim); font-size: 13.5px; }\n"
".banner .btn, .banner .icon-btn { margin-left: 12px; }\n"
"\n"
".state { text-align: center; padding: 48px 20px; border: 1px dashed var(--border); border-radius: var(--r-lg); background: rgba(var(--white-rgb), .015); }\n"
".state-ic { display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; margin-bottom: 14px; border-radius: 50%; background: rgba(var(--white-rgb), .06); color: var(--dim); }\n"
".state-ic .ic { width: 26px; height: 26px; }\n"
".state.err .state-ic { background: rgba(var(--err-rgb), .12); color: var(--err); }\n"
".state.warn .state-ic { background: rgba(var(--warn-rgb), .12); color: var(--warn); }\n"
".state.info .state-ic { background: rgba(var(--accent-rgb), .12); color: var(--accent-hover); }\n"
".state h3 { font-size: 17px; font-weight: 750; margin-bottom: 6px; }\n"
".state p { max-width: 46ch; margin: 0 auto; color: var(--dim); font-size: 14px; }\n"
".state .row { justify-content: center; margin-top: 18px; }\n"
"details.tech { max-width: 520px; margin: 16px auto 0; text-align: left; }\n"
"details.tech > summary { cursor: pointer; color: var(--dim); font-size: 12.5px; font-weight: 650; list-style: none; }\n"
"details.tech > summary::-webkit-details-marker { display: none; }\n"
"details.tech > summary::before { content: \"+ \"; }\n"
"details.tech[open] > summary::before { content: \"\\2212 \"; }\n"
"details.tech pre { margin: 8px 0 0; padding: 10px 12px; border-radius: var(--r-md); background: var(--bg); border: 1px solid var(--border); color: var(--dim); font: 12px/1.5 ui-monospace, Menlo, Consolas, monospace; white-space: pre-wrap; word-break: break-word; }\n"
"\n"
".sk {\n"
"  background: linear-gradient(90deg, var(--panel-2) 25%, rgba(var(--white-rgb), .07) 50%, var(--panel-2) 75%);\n"
"  background-size: 200% 100%; animation: shimmer 1.6s linear infinite; border-radius: var(--r-sm);\n"
"}\n"
".sk-tile { border-radius: var(--r-lg); border: 1px solid var(--border); background: var(--panel); overflow: hidden; }\n"
