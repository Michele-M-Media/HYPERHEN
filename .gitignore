# Frozen binary inputs are distributed as checksum-pinned release assets.
/build-release/
/release-components/*
!/release-components/SHA256SUMS
!/release-components/MANIFEST.json
/release-inputs/*
!/release-inputs/SHA256SUMS
!/release-inputs/MANIFEST.json
